# Copia este archivo como .env (nunca versiones el .env real)
NODE_ENV=development
PORT=5000

# Obligatorio: secreto de firma JWT. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Orígenes CORS permitidos, separados por coma (vacío = solo mismo origen / proxy)
CORS_ORIGIN=

# Sirve frontend/dist desde el backend en producción
SERVE_FRONTEND=false

# URL pública del frontend, usada en los enlaces de los correos automáticos
PUBLIC_APP_URL=http://localhost:5173

# Base de datos: vacío = SQLite local (backend/data/aquachile.db).
# Con URL = PostgreSQL en la nube (Supabase): postgresql://usuario:clave@host:puerto/basedatos
DATABASE_URL=

# Límite de tamaño por archivo adjunto (MB)
LIMITE_ARCHIVO_MB=5

# Cuenta semilla del evaluador (se crea solo si el correo no existe)
EVALUADOR_EMAIL=evaluador@aquachile.cl
EVALUADOR_NOMBRE=Evaluador Psicolaboral
EVALUADOR_PASSWORD=

# Cuenta semilla del analista de reclutamiento (se crea solo si el correo no existe)
ANALISTA_EMAIL=analista@aquachile.cl
ANALISTA_NOMBRE=Analista de Reclutamiento
ANALISTA_PASSWORD=

# Correo automático al aceptar un candidato (SMTP).
# Si SMTP_HOST queda vacío, el cambio de estado funciona pero no se envía correo.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Reclutamiento AquaChile <reclutamiento@aquachile.cl>
SMTP_REPLY_TO=

# Carga un lote demostrativo de candidatos la primera vez que arranca
SEED_DEMO=true
