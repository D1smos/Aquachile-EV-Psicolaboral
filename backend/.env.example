# Copia este archivo como .env (nunca versiones el .env real)
NODE_ENV=development
PORT=5000

# Obligatorio: secreto de firma JWT. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Orígenes CORS permitidos, separados por coma (vacío = solo mismo origen / proxy)
CORS_ORIGIN=

# Sirve frontend/dist desde el backend en producción
SERVE_FRONTEND=false

# URL pública del frontend, usada en los enlaces de los correos automáticos
PUBLIC_APP_URL=http://localhost:5173

# Base de datos: vacío = SQLite local (backend/data/aquachile.db).
# Con URL = PostgreSQL en la nube (Supabase): postgresql://usuario:clave@host:puerto/basedatos
DATABASE_URL=

# Almacenamiento de CV y antecedentes: local (backend/uploads) o supabase.
STORAGE_PROVIDER=local
# Solo si STORAGE_PROVIDER=supabase. Usa la Service Role Key (nunca la anon key).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=aquachile-documentos
# Segundos de validez de las URLs firmadas de descarga/previsualización.
STORAGE_SIGNED_URL_TTL=60

# Límite de tamaño por archivo adjunto (MB)
LIMITE_ARCHIVO_MB=5

# Documentos internos y extracción de texto
LIMITE_DOCUMENTO_MB=10
MAX_CARACTERES_TEXTO=120000
MAX_CARACTERES_PROMPT=24000

# Análisis con IA mediante OpenRouter
IA_HABILITADA=false
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemini-2.0-flash-exp:free
LLM_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,qwen/qwen-2.5-72b-instruct:free
LLM_TIMEOUT_MS=45000
LLM_MAX_TOKENS=2000
IA_RATE_LIMIT=10
LLM_APP_URL=http://localhost:5173
LLM_APP_NAME=AquaChile-Psicolaboral

# Cuenta semilla del evaluador (se crea solo si el correo no existe)
EVALUADOR_EMAIL=evaluador@aquachile.cl
EVALUADOR_NOMBRE=Evaluador Psicolaboral
EVALUADOR_PASSWORD=

# Cuenta semilla del analista de reclutamiento (se crea solo si el correo no existe)
ANALISTA_EMAIL=analista@aquachile.cl
ANALISTA_NOMBRE=Analista de Reclutamiento
ANALISTA_PASSWORD=

# Correo automático al aceptar un candidato (SMTP).
# Si SMTP_HOST queda vacío, el cambio de estado funciona pero no se envía correo.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Reclutamiento AquaChile <reclutamiento@aquachile.cl>
SMTP_REPLY_TO=

# Correo transaccional con Resend. Si RESEND_API_KEY queda vacío se usa el SMTP anterior.
RESEND_API_KEY=
RESEND_FROM_EMAIL="AquaChile <onboarding@resend.dev>"
RESEND_ENCARGADO_EMAIL=evaluador@aquachile.cl

# Google Calendar (local-first: si está deshabilitado, las entrevistas quedan en BD local)
GOOGLE_HABILITADO=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integraciones/google/callback
GOOGLE_CALENDAR_ID=primary
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
CALENDAR_TIMEZONE=America/Santiago

# Carga un lote demostrativo de candidatos la primera vez que arranca
SEED_DEMO=true
