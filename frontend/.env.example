# Copia este archivo como .env (nunca versiones el .env real)
# Ruta base de la API usada por el navegador (relativa = misma origen)
VITE_API_URL=/api

# Destino del proxy de desarrollo de Vite hacia el backend
VITE_API_PROXY_TARGET=http://127.0.0.1:5000

# Puerto del servidor de desarrollo
VITE_PORT=5173
